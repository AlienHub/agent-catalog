{
  "name": "agent-atlas",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../cloudflare-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "ACCESS_OWNER_EMAIL": "",
    "COLLECTION_ENABLED": "false",
    "CACHE_SECONDS": "300",
    "SHARD_COUNT": "7",
    "SHARD_START_MINUTE": "17"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-atlas-trends",
      "database_id": "REPLACE_WITH_EXISTING_D1_UUID",
      "migrations_dir": "../services/trends/migrations"
    }
  ],
  "routes": [
    {
      "pattern": "agent-atlas.pindo.page",
      "custom_domain": true
    }
  ]
}
