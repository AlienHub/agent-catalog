{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM model API providers and relay stations",
  "description": "Operating service sites and API endpoints only, classified as model-vendor (模型厂商), third-party (三方供应商), or relay (中转站). Open-source backend projects such as one-api/new-api are attributes, not catalog entries. Listing is not endorsement.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "aliases",
      "operator",
      "type",
      "trust_level",
      "website",
      "api_base_urls",
      "api_compat",
      "models",
      "pricing",
      "payment_methods",
      "backend",
      "region",
      "status",
      "first_seen",
      "last_checked",
      "discovery_source",
      "related_ids",
      "related_sites",
      "icon",
      "risk_notes",
      "evidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "operator": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "model-vendor",
          "third-party",
          "relay"
        ]
      },
      "trust_level": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      },
      "models_dev_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "ccswitch_preset_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "website": {
        "type": "string",
        "format": "uri"
      },
      "api_base_urls": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        },
        "uniqueItems": true
      },
      "api_compat": {
        "type": "array",
        "items": {
          "enum": [
            "openai",
            "anthropic",
            "gemini"
          ]
        },
        "uniqueItems": true
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "pricing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "ratio_note"
        ],
        "properties": {
          "unit": {
            "type": "string"
          },
          "ratio_note": {
            "type": "string"
          }
        }
      },
      "payment_methods": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "backend": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "software",
          "version",
          "detected_by"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "detected_by": {
            "type": "string"
          }
        }
      },
      "region": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "active",
          "unstable",
          "dead",
          "closed"
        ]
      },
      "first_seen": {
        "type": "string",
        "format": "date"
      },
      "last_checked": {
        "type": "string",
        "format": "date"
      },
      "discovery_source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "url"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "related_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "uniqueItems": true
      },
      "related_sites": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        },
        "uniqueItems": true
      },
      "icon": {
        "type": "string"
      },
      "risk_notes": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "title",
            "checked_at",
            "http",
            "api_status"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "checked_at": {
              "type": "string",
              "format": "date"
            },
            "http": {
              "type": "integer",
              "minimum": 0,
              "maximum": 599
            },
            "api_status": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
