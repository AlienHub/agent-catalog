{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Atlas application catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "aliases",
      "vendor",
      "type",
      "website",
      "platforms",
      "icon",
      "vendor_id",
      "product_id",
      "svg_status",
      "interfaces",
      "chrome_extension_id",
      "edge_extension_id",
      "web_url",
      "web_domains",
      "web_domain_entries",
      "web_domain_status",
      "web_domain_verified_at"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "vendor": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "type": "string"
      },
      "website": {
        "type": "string",
        "format": "uri"
      },
      "platforms": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 0,
        "uniqueItems": true
      },
      "icon": {
        "type": "string",
        "description": "Relative path to an original SVG or PNG Logo; empty when unavailable"
      },
      "vendor_id": {
        "type": "string"
      },
      "product_id": {
        "type": "string"
      },
      "svg_status": {
        "type": "string",
        "description": "SVG availability; PNG entries explicitly state PNG raster format and missing SVG"
      },
      "interfaces": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "GUI",
            "CLI",
            "IDE 插件",
            "Web",
            "浏览器插件",
            "小程序"
          ]
        },
        "minItems": 1,
        "maxItems": 1,
        "description": "Exactly one interaction form per independently identified application; product_id groups related applications."
      },
      "chrome_extension_id": {
        "type": "string",
        "pattern": "^$|^[a-p]{32}$",
        "description": "Verified official Chrome Web Store extension ID; empty means unverified or not applicable"
      },
      "edge_extension_id": {
        "type": "string",
        "pattern": "^$|^[a-p]{32}$",
        "description": "Verified official Microsoft Edge Add-ons extension ID; empty means unverified or not applicable"
      },
      "web_url": {
        "type": "string",
        "description": "Verified actual Web application entry URL, distinct from marketing website; empty if unverified, self-hosted or not applicable"
      },
      "web_domains": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "uniqueItems": true,
        "description": "Verified exact application hostnames, no wildcard, protocol, path, API or CDN domains. Shared hosts require URL path context. Must match web_domain_entries[].host in the same order."
      },
      "web_domain_entries": {
        "type": "array",
        "description": "Labeled application hosts for the same record: primary, regional, legacy or alternate. Empty when not verified. web_domains remains the searchable hostname list.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "url",
            "role",
            "label"
          ],
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            },
            "url": {
              "type": "string",
              "description": "Canonical https entry for this host; empty only when the parent record is not verified"
            },
            "role": {
              "type": "string",
              "enum": [
                "primary",
                "regional",
                "legacy",
                "alternate"
              ]
            },
            "label": {
              "type": "string",
              "description": "Optional region or legacy note; empty when unused"
            }
          }
        }
      },
      "web_domain_status": {
        "type": "string",
        "enum": [
          "verified",
          "unverified",
          "self-hosted",
          "not-applicable"
        ]
      },
      "web_domain_verified_at": {
        "type": "string",
        "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}
