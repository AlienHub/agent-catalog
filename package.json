{
  "name": "@alienhub/agent-atlas",
  "version": "0.1.0",
  "description": "Private, versioned AI application catalog with framework-free queries and optional React icons",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/esm/icons.d.ts",
        "default": "./dist/esm/icons.js"
      },
      "require": {
        "types": "./dist/cjs/icons.d.ts",
        "default": "./dist/cjs/icons.js"
      }
    },
    "./dataset.json": "./data/dataset.json",
    "./evidence.json": "./data/evidence.json",
    "./schema.json": "./data/schema.json",
    "./collections.json": "./data/collections.json",
    "./metadata.json": "./data/metadata.json",
    "./icons/*.svg": "./assets/icons/*.svg",
    "./licenses/*": "./licenses/*",
    "./package.json": "./package.json",
    "./open-source.json": "./data/open-source.json",
    "./open-source-schema.json": "./data/open-source-schema.json",
    "./commercial.json": "./data/commercial.json",
    "./commercial-schema.json": "./data/commercial-schema.json"
  },
  "files": [
    "dist",
    "data",
    "assets/icons",
    "licenses",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "build": "node scripts/build.mjs",
    "build:website": "node scripts/build-website.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm test && node scripts/verify-package.mjs && npm run build:website && node scripts/verify-website.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test:trends": "npm --prefix services/trends test",
    "verify:all": "npm run verify && npm run test:trends && npm run test:cloudflare && npm run build:cloudflare",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "test:cloudflare": "node --test cloudflare/*.test.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "esbuild": "0.25.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AlienHub/agent-catalog.git"
  },
  "bugs": {
    "url": "https://github.com/AlienHub/agent-catalog/issues"
  },
  "homepage": "https://github.com/AlienHub/agent-catalog#readme"
}
